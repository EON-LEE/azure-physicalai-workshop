{
  "name": "@physicalai/factory-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "generate:schema": "node scripts/generate-schema.mjs",
    "predev": "npm run generate:schema",
    "pretypecheck": "npm run generate:schema",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run generate:schema",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:public-e2e": "playwright test --config playwright.public.config.ts",
    "prebuild": "npm run generate:schema",
    "build": "tsc --noEmit && vite build && node scripts/check-production.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:fixture-server": "npm run generate:schema && vite build --config tests/browser/vite.config.ts && vite preview --config tests/browser/vite.config.ts --host 127.0.0.1 --port 4178 --strictPort"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.23.0",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "ajv": "^8.17.1",
    "esbuild": "^0.25.9",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
