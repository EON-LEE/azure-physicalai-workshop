ARG ASSET_IMAGE
FROM ${ASSET_IMAGE} AS assets
FROM nvcr.io/nvidia/isaac-sim:6.0.0
USER root
WORKDIR /app
COPY simulation/requirements.txt simulation/requirements.txt
RUN /isaac-sim/python.sh -m pip install --no-cache-dir -r simulation/requirements.txt
COPY --from=assets /opt/physicalai/reference /opt/physicalai/reference
COPY apps/__init__.py apps/__init__.py
COPY apps/api/ apps/api/
COPY contracts/ contracts/
COPY simulation/ simulation/
COPY learning/__init__.py learning/common.py learning/contract.py learning/capture.py learning/
ENV PYTHONPATH=/app PYTHONUNBUFFERED=1 ISAAC_SIM_VERSION=6.0.0
USER 1234:1234
ENTRYPOINT ["/isaac-sim/python.sh", "-m", "simulation.bootstrap_tls"]
